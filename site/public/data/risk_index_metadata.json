    "Hazard_Index": "[norm(compound_c) + norm(mean_overl) + norm(mean_compo)] / 3.",
    "Risk_Comp": "(SVI_Coast_2022 / 100) x norm(compound_c).",
    "Risk_Hazard": "(SVI_Coast_2022 / 100) x Hazard_Index."
  }
}
